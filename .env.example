# ResellSnap AI — environment template.
#
# Copy to `.env` and fill in. Never commit a filled-in copy: `.env` is ignored.
# Every value here is a placeholder or a comment. No real secrets.
#
# The app validates this on boot and refuses to start in production if
# something required is missing, rather than failing later under load.

# ---------------------------------------------------------------------------
# Core — required everywhere
# ---------------------------------------------------------------------------

# Absolute, no trailing slash. Must match the address browsers actually use,
# or auth cookies and OAuth redirects will not line up.
APP_URL=http://localhost:3000

# PostgreSQL. On Railway, reference the database service:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/resellsnap

# Session signing key. Generate with:  openssl rand -base64 48
BETTER_AUTH_SECRET=

# AES-256-GCM key for encrypting marketplace OAuth tokens at rest.
# Exactly 64 hex characters. Generate with:  openssl rand -hex 32
# Changing this makes every stored marketplace connection unreadable.
TOKEN_ENCRYPTION_KEY=

# The first super admin. `pnpm bootstrap:admin` promotes this address; the
# command is idempotent and there is no universal admin password anywhere.
SUPER_ADMIN_EMAIL=

# ---------------------------------------------------------------------------
# AI
# ---------------------------------------------------------------------------

# "openai" in production. "fake" returns deterministic fixtures for local work
# and tests — production refuses to start if it is set.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_TEXT_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=

# Daily ceiling on estimated AI spend, in USD cents. 0 disables the breaker.
AI_DAILY_COST_LIMIT_CENTS=0

# ---------------------------------------------------------------------------
# Storage — S3-compatible object storage
# ---------------------------------------------------------------------------

# "s3" in production; "local" writes to disk and is refused in production.
STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Only used by the local driver.
LOCAL_STORAGE_DIR=.storage

# ---------------------------------------------------------------------------
# Billing — Stripe (optional; billing is disabled until it is set)
# ---------------------------------------------------------------------------

STRIPE_SECRET_KEY=
# From the webhook endpoint you create for /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# Price IDs from your own Stripe account. The app never creates Stripe
# products or prices itself, so a deployment cannot spawn live objects.
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PACK_20=
STRIPE_PRICE_PACK_75=
STRIPE_PRICE_PACK_200=

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------

# "resend" in production; "console" just logs, for local work.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=ResellSnap AI <no-reply@example.com>
SUPPORT_EMAIL=support@example.com

# ---------------------------------------------------------------------------
# eBay (optional; the integration shows as "not configured" until all three
# are set, and no Connect button is offered)
# ---------------------------------------------------------------------------

EBAY_ENVIRONMENT=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# NOT a URL. eBay's OAuth redirect parameter is a RuName, taken from the
# redirect you configure in your eBay developer account.
EBAY_REDIRECT_URI=
EBAY_MARKETPLACE_ID=EBAY_US

# ---------------------------------------------------------------------------
# Google sign-in (optional)
# ---------------------------------------------------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------

# Shared secret for the scheduled maintenance endpoint.
CRON_SECRET=
SENTRY_DSN=

MAX_UPLOAD_BYTES=15728640
MAX_PHOTOS_PER_ITEM=12
WORKER_CONCURRENCY=4
WORKER_POLL_MS=2000

# Relaxes Better Auth's credential rate limits so an end-to-end suite can drive
# the real forms repeatedly from one address. Production refuses to start if
# this is set to "relaxed". Leave it alone unless you are running the E2E suite.
AUTH_RATE_LIMIT=strict
